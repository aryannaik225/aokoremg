# Elexon BMRS API
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Decision-time semantics
# Cutoff time (UK local, 24h HH:MM) on day D-1 before which a WINDFOR
# publishTime must fall to be considered "available at decision time".
DECISION_CUTOFF_TIME=11:00

# Delivery-day window in scope (inclusive)
DELIVERY_WINDOW_START=2026-01-02
DELIVERY_WINDOW_END=2026-02-01

# Storage
DB_PATH=./data/gridbricks.db

# CORS
FRONTEND_ORIGIN=http://localhost:5173
